[global]
    monitor = 1

    width = 320
    height = (0, 65)

    origin = top-center
    offset = (0, -27)

    sort = update

    timeout = 10s
    stack_duplicates = false
    notification_limit = 1

    padding = 14
    horizontal_padding = 12
    gap_size = 5

    font = Inter 10
    foreground = "rgb(215, 215, 215)"

    background = "#000000"
    frame_color = "#1f1f1f"
    frame_width = 2
    corner_radius = 15
